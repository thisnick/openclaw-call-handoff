{
  "name": "openclaw-call-handoff",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --config ./vitest.config.ts",
    "pack": "npm run build && npm pack"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "2026.9.8",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8"
    }
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "description": "OpenClaw plugin: hand a live voice call over to a human",
  "repository": {
    "type": "git",
    "url": "https://github.com/thisnick/openclaw-call-handoff.git"
  },
  "license": "MIT"
}
