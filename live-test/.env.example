# Copy to a private file (never commit real numbers) and load it before run.sh.
OTACON_AUDIO_HOST=otacon.example.ts.net
# Registry ids (otacon phones list) and host-local ids (GET /phones on the otacon host)
BUSINESS_PHONE=phone-2
BUSINESS_HOST_ID=phone-xxxxxxxx
BUSINESS_NUMBER=+15550001000
HUMAN_PHONE=phone-3
HUMAN_HOST_ID=phone-yyyyyyyy
# How to run the OpenClaw CLI against the gateway under test
GATEWAY_CLI="docker exec openclaw-gateway node /app/dist/index.js"
OPENAI_API_KEY=sk-...
# Optional
SCENARIO=answer
MAX_SECONDS=240
